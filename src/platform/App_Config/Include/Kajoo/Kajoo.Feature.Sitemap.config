<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <services>
      <configurator type="Kajoo.Feature.Sitemap.DependencyInjection.ServicesConfigurator, Kajoo.Feature.Sitemap"/>
    </services>
    <pipelines>
      <mvc.renderRendering>
        <processor type="Kajoo.Feature.Sitemap.Pipelines.RenderRendering.InsertKajooMetadataBefore, Kajoo.Feature.Sitemap" patch:before="processor[@type='Sitecore.Mvc.Pipelines.Response.RenderRendering.ExecuteRenderer, Sitecore.Mvc']"  resolve="true" />
        <processor type="Kajoo.Feature.Sitemap.Pipelines.RenderRendering.InsertKajooMetadataAfter, Kajoo.Feature.Sitemap" patch:after="processor[@type='Sitecore.Mvc.Pipelines.Response.RenderRendering.ExecuteRenderer, Sitecore.Mvc']" resolve="true" />
      </mvc.renderRendering>
    </pipelines>
    <settings>
      <setting name="ExcludedRenderings" value="" />
    </settings>
  </sitecore>
</configuration>